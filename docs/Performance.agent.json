  },
  "blocks": [
    {
      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# Surface rendering cost\n",
      "level": 1,
      "title": "Surface rendering cost"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 6,
      "raw": "Hue and brightness rails depend on the row coordinate only. The renderer samples\neach row once and copies that exact RGBA8 pixel across the row. Horizontal ramps\nand spectrum retain their existing first-row reuse. Color conversion work for a\nvertical rail is O(height), while writing the output remains O(width * height).\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 7,
      "end_line": 7,
      "raw": "\n"
    },
    {
      "id": "b000005",
      "kind": "paragraph",
      "start_line": 8,
      "end_line": 11,
      "raw": "The surface regression compares every output channel to independent scalar\n`Picker::surfaceColor` sampling for all seven surface types, including one-pixel\ndimensions, non-square images, wheel transparency and the alpha channel. Color\nrounding, orientation, geometry limits and picker state are unchanged.\n"
    },
    {
      "id": "b000006",
      "kind": "blank",
      "start_line": 12,
      "end_line": 12,
      "raw": "\n"
    },
    {
      "id": "b000007",
      "kind": "paragraph",
      "start_line": 13,
      "end_line": 13,
      "raw": "The SDK-wide performance record is under `SDK/build/performance-20261020/`.\n"
    }
  ],
