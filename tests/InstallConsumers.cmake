cmake_minimum_required(VERSION 3.24)
if(NOT BUILD_ROOT OR NOT SOURCE_ROOT OR NOT CTEST_COMMAND)
    message(FATAL_ERROR "Consumer verification requires its build, source and CTest paths")
endif()
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 _run_id)
set(_root "${BUILD_ROOT}/package-tests/${_run_id}")
file(MAKE_DIRECTORY "${_root}")
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE _status OUTPUT_VARIABLE _out ERROR_VARIABLE _error)
    message("${_out}${_error}")
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Installed consumer command failed: ${ARGV}")
    endif()
endfunction()
foreach(_kind values picker)
    set(_stage "${_root}/${_kind}/stage")
    if(_kind STREQUAL "values")
        run("${CMAKE_COMMAND}" --install "${BUILD_ROOT}" --config "${BUILD_CONFIG}" --component Values --prefix "${_stage}")
    else()
        run("${CMAKE_COMMAND}" --install "${BUILD_ROOT}" --config "${BUILD_CONFIG}" --prefix "${_stage}")
    endif()
    set(_relocated "${_root}/${_kind}/relocated")
    file(RENAME "${_stage}" "${_relocated}")
    if(_kind STREQUAL "values")
        file(GLOB_RECURSE _files "${_relocated}/*")
        foreach(_file IN LISTS _files)
            if(_file MATCHES "\\.(dll|dylib|a|lib)$|\\.so(\\.[0-9.]+)?$")
                message(FATAL_ERROR "Values-only installation included a library: ${_file}")
            endif()
        endforeach()
    endif()
    set(_build "${_root}/${_kind}/consumer/build")
    run("${CMAKE_COMMAND}" -S "${SOURCE_ROOT}/tests/${_kind}_consumer" -B "${_build}" -G "${BUILD_GENERATOR}"
        "-DiiColorManager_DIR=${_relocated}/${INSTALL_LIBDIR}/cmake/iiColorManager" "-DCMAKE_BUILD_TYPE=${BUILD_CONFIG}"
        "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_CXX_FLAGS=${CONSUMER_FLAGS}"
        "-DCMAKE_OSX_DEPLOYMENT_TARGET=${DEPLOYMENT_TARGET}")
    run("${CMAKE_COMMAND}" --build "${_build}" --config "${BUILD_CONFIG}" --parallel 2)
    run("${CTEST_COMMAND}" --test-dir "${_build}" --build-config "${BUILD_CONFIG}" --output-on-failure)
endforeach()
