if(NOT DEFINED SOURCE_ROOT OR NOT DEFINED BUILD_ROOT OR NOT DEFINED DATA_DIR OR NOT DEFINED INSTALL_LIBDIR)
    message(FATAL_ERROR "License verification requires SOURCE_ROOT, BUILD_ROOT, DATA_DIR and INSTALL_LIBDIR")
endif()
function(require_text path needle description)
    file(READ "${path}" _body)
    string(FIND "${_body}" "${needle}" _found)
    if(_found LESS 0)
        message(FATAL_ERROR "${description}: ${path}")
    endif()
endfunction()
function(reject_text path needle description)
    file(READ "${path}" _body)
    string(FIND "${_body}" "${needle}" _found)
    if(NOT _found LESS 0)
        message(FATAL_ERROR "${description}: ${path}")
    endif()
endfunction()
require_text("${SOURCE_ROOT}/LICENSE" "Apache License" "LICENSE is not the Apache License")
require_text("${SOURCE_ROOT}/LICENSE" "Version 2.0, January 2004" "LICENSE is not Apache License Version 2.0")
require_text("${SOURCE_ROOT}/LICENSE" "TERMS AND CONDITIONS FOR USE, REPRODUCTION, AND DISTRIBUTION" "LICENSE is missing the Apache terms")
require_text("${SOURCE_ROOT}/LICENSE" "END OF TERMS AND CONDITIONS" "LICENSE is missing the end of the Apache terms")
require_text("${SOURCE_ROOT}/LICENSE" "APPENDIX: How to apply the Apache License to your work." "LICENSE is missing the Apache appendix")
reject_text("${SOURCE_ROOT}/LICENSE" "MIT License" "LICENSE still contains the MIT grant")
reject_text("${SOURCE_ROOT}/LICENSE" "Permission is hereby granted, free of charge" "LICENSE still contains the MIT permission notice")
require_text("${SOURCE_ROOT}/NOTICE" "Copyright (c) 2026 iisacc" "NOTICE is missing the copyright line")
require_text("${SOURCE_ROOT}/NOTICE" "Apache License" "NOTICE does not name the Apache License")
require_text("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: Apache-2.0" "README SPDX identifier is not Apache-2.0")
reject_text("${SOURCE_ROOT}/README.md" "SPDX-License-Identifier: MIT" "README still identifies MIT")
require_text("${SOURCE_ROOT}/docs/License.md" "SPDX-License-Identifier: Apache-2.0" "Korean license statement is not Apache-2.0")
require_text("${SOURCE_ROOT}/AGENT.md" "Apache License 2.0" "AGENT.md does not state Apache-2.0")
require_text("${SOURCE_ROOT}/cmake/iiColorManagerConfig.cmake.in" "set(iiColorManager_SPDX_LICENSE \"Apache-2.0\")" "Package config does not export iiColorManager_SPDX_LICENSE")
require_text("${BUILD_ROOT}/iiColorManagerConfig.cmake" "set(iiColorManager_SPDX_LICENSE \"Apache-2.0\")" "Generated package config does not export iiColorManager_SPDX_LICENSE")
require_text("${SOURCE_ROOT}/CMakeLists.txt" "set(iiColorManager_SPDX_LICENSE \"Apache-2.0\")" "CMake project metadata does not set iiColorManager_SPDX_LICENSE")

function(installed_matches prefix)
    set(_pairs
        "LICENSE|LICENSE"
        "NOTICE|NOTICE"
        "docs/License.md|docs/License.md")
    foreach(_pair IN LISTS _pairs)
        string(REPLACE "|" ";" _parts "${_pair}")
        list(GET _parts 0 _relative)
        list(GET _parts 1 _source)
        set(_document "${prefix}/${DATA_DIR}/iiColorManager/${_relative}")
        if(NOT EXISTS "${_document}")
            message(FATAL_ERROR "The installed ${_relative} is missing from ${prefix}")
        endif()
        file(SHA256 "${SOURCE_ROOT}/${_source}" _expected)
        file(SHA256 "${_document}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "The installed ${_relative} differs from the maintained source")
        endif()
    endforeach()
    set(_config "${prefix}/${INSTALL_LIBDIR}/cmake/iiColorManager/iiColorManagerConfig.cmake")
    if(NOT EXISTS "${_config}")
        message(FATAL_ERROR "The installed package config is missing from ${prefix}")
    endif()
    require_text("${_config}" "set(iiColorManager_SPDX_LICENSE \"Apache-2.0\")" "Installed package config does not export iiColorManager_SPDX_LICENSE")
endfunction()

function(run_install prefix)
    cmake_parse_arguments(_install "" "COMPONENT" "" ${ARGN})
    if(_install_COMPONENT)
        execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_ROOT}" --prefix "${prefix}" --component "${_install_COMPONENT}"
            RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_ROOT}" --prefix "${prefix}"
            RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    endif()
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Installation failed: ${_output}\n${_error}")
    endif()
endfunction()

set(_root "${BUILD_ROOT}/license-install-test")
file(REMOVE_RECURSE "${_root}")
run_install("${_root}/all")
installed_matches("${_root}/all")
run_install("${_root}/values" COMPONENT Values)
installed_matches("${_root}/values")
file(REMOVE_RECURSE "${_root}")
message(STATUS "Apache-2.0 LICENSE, NOTICE, Korean statement, and SPDX package metadata match the installed files")
