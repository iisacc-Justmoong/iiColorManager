if(NOT DEFINED PROJECT_SOURCE_DIR)
    message(FATAL_ERROR "PROJECT_SOURCE_DIR is required")
endif()
if(IS_DIRECTORY "${PROJECT_SOURCE_DIR}/src/iiColorManager")
    message(FATAL_ERROR "The source tree must not repeat the project name")
endif()
foreach(_file ColorManager.h ColorManager.cpp ColorValue.h)
    if(NOT EXISTS "${PROJECT_SOURCE_DIR}/src/${_file}")
        message(FATAL_ERROR "Missing color interface or implementation under src/: ${_file}")
    endif()
endforeach()
